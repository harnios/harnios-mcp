# Connection settings for the S3-compatible storage backend this app uses
# (spec 007-s3-storage-config). Copy this file to frontend/.env.local and
# adjust values to point at any S3-compatible provider — Next.js only loads
# .env files from its own project root (frontend/), not the repo root.
#
# The defaults below match this repo's local self-hosted MinIO instance
# (see docker-compose.yml and the repo-root .env.example, which configures
# the MinIO container itself). The bucket named below must already exist —
# it is not created automatically; see specs/007-s3-storage-config/quickstart.md.

# Full URL of the S3-compatible endpoint, including scheme.
# Use https:// for providers that require TLS.
S3_ENDPOINT=http://localhost:9000

# Region to sign requests with. Many self-hosted S3-compatible servers
# (e.g. MinIO) accept any value here.
S3_REGION=us-east-1

# Access key / secret key for the configured provider.
# Must match docker-compose.yml's MINIO_ROOT_USER/MINIO_ROOT_PASSWORD for local dev.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Name of the bucket this app uses as its storage root. Must already exist.
S3_BUCKET=mcp-storage

# "true" for path-style addressing (endpoint/bucket) — required by most
# self-hosted S3-compatible servers, including MinIO. Set to "false" for
# providers that require virtual-hosted-style addressing (bucket.endpoint).
S3_FORCE_PATH_STYLE=true

# Owner credential for the OAuth sign-in/consent screen (spec 008-mcp-oauth).
# This is separate from the S3/MinIO credentials above — it's what gates
# approving AI assistants (ChatGPT, Claude, etc.) as MCP connectors, not
# storage access.
OAUTH_OWNER_USERNAME=owner
OAUTH_OWNER_PASSWORD=

# Storage-relative path to a Markdown "bootstrap" file (spec
# 010-dynamic-tool-descriptions). When set, MCP tool descriptions are
# prepended with generated guidance sourced from this file's optional
# <!-- mcp-context: ... --> and <!-- mcp-triggers: ... --> HTML-comment
# markers. Optional — if unset, missing, or unreadable, tools fall back to
# their plain original descriptions with no error.
MCP_BOOTSTRAP_PATH=assistant/AGENTS.md

# Branding name shown in the page <title> and the app header. Optional —
# defaults to "harness-mcp" if unset.
OS_NAME=risorse-os

# SMTP account used by the send_email MCP tool (spec 017-mcp-email-telegram-tools).
# One pre-configured account per deployment — callers of the tool never supply
# their own credentials. Required for send_email to work; missing/invalid
# values surface as a clear "missing_config" tool error, not a startup crash.
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS; "false" (default) for STARTTLS on the given port.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Sender identity stamped on every outbound email, e.g. "Risorse OS <noreply@example.com>".
SMTP_FROM=

# Telegram bot token (from @BotFather) used by the send_telegram_message MCP
# tool. The bot must already be added to any target chat/channel before use —
# this tool does not handle bot invitation.
TELEGRAM_BOT_TOKEN=

# Default chat/channel the send_telegram_message tool posts to when the
# caller doesn't specify one. Optional — if unset, chatId must be passed on
# every call instead.
TELEGRAM_CHAT_ID=

# Shared send-rate limit across both send_email and send_telegram_message,
# to deter runaway/abusive usage. Optional — defaults shown below.
MESSAGING_RATE_LIMIT_MAX=20
MESSAGING_RATE_LIMIT_WINDOW_MINUTES=60

# MCP_DISABLED_TOOLS (spec 023-mcp-tool-toggle) is no longer read — as of
# spec 025-manage-tools-page, which tools are active/disabled is managed
# from the /tools page (sign in as owner) and persisted in storage instead
# of an environment variable. Setting this variable now has no effect.

# Scheduler (spec 032-scheduled-tasks) — an owner defines Scheduled Tasks as
# files under os/schedules/*.md, each with a cron expression, an assigned
# model, and a prompt. A background heartbeat inside this server process
# runs due tasks against the Mistral API, giving the model access to this
# server's own native tools (send_email, etc.). Required only if any
# os/schedules/*.md file exists; missing/invalid values surface as a
# "missing_config" failure on that task's execution, not a startup crash.
MISTRAL_API_KEY=
# Must be one of the models listed in lib/scheduler/models.ts.
MISTRAL_MODEL=mistral-large-latest

# IANA timezone a Scheduled Task's cron expression is evaluated in when the
# task's own file doesn't specify a `timezone:` front-matter field.
SCHEDULER_TIMEZONE=UTC

# Set to "false" to disable the in-process scheduler heartbeat entirely —
# e.g. when intentionally running more than one replica of this app, since
# each replica would otherwise independently poll and could double-run the
# same due task (see specs/032-scheduled-tasks/spec.md, Assumptions). The
# heartbeat is also automatically disabled on Vercel regardless of this
# value, since a serverless function has no persistent process for it to
# run in.
SCHEDULER_ENABLED=true
